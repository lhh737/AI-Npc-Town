# ===========================================
# HelloAgents AI Town - 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ===========================================

# ---- API 服务配置 ----
API_HOST=0.0.0.0
API_PORT=8000

# NPC 状态更新间隔（秒）
NPC_UPDATE_INTERVAL=30

# ---- LLM 配置（必填）----
# 使用 ModelScope API（推荐，国内可直连）
LLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/

# 其他兼容 OpenAI 协议的服务示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_ID=qwen-plus

# ---- Qdrant 向量数据库（可选，用于长期记忆）----
# 云服务：https://cloud.qdrant.io/
#QDRANT_URL=https://your-cluster.qdrant.io
#QDRANT_API_KEY=your-qdrant-key
# 本地：需要 Docker
# QDRANT_URL=http://localhost:6333
#QDRANT_COLLECTION=ai_town_memories
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=30

# ---- Neo4j 图数据库（可选）----
# 云服务：https://neo4j.com/cloud/aura/
#NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
#NEO4J_USERNAME=neo4j
#NEO4J_PASSWORD=your-password
# 本地：需要 Docker
# NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# ---- Embedding 配置 ----
# 类型：dashscope（API）或 local（本地模型）
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=your-embedding-key
EMBED_BASE_URL=
